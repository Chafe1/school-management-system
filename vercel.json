{
  "installCommand": "npm install --prefix backend && npm install --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/teacher/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/student/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/parent/:path*",
      "destination": "/index.html"
    }
  ]
}
